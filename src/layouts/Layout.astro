---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Astro description' } = Astro.props;

// Import global styles
import '../styles/global.css';
import Header from '../components/Header.jsx';
---

<!DOCTYPE html>
<html lang="en" class="emerald-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <slot name="head" />
    <script is:inline>
      // Theme initialization script
      (function() {
        const stored = localStorage.getItem('theme') || 'emerald-dark';
        const root = document.documentElement;
        const body = document.body;
        
        // Remove all theme classes
        ['light', 'dark', 'emerald-dark'].forEach(theme => {
          root.classList.remove(theme);
          body.classList.remove(theme);
        });
        
        // Add current theme class
        root.classList.add(stored);
        body.classList.add(stored);
      })();
    </script>
  </head>
  <body class="bg-background text-foreground font-sans antialiased overflow-x-hidden">
    <!-- Global site header/navigation -->
    <Header client:only="react" />
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
  }
  
  * {
    box-sizing: border-box;
  }
  
  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }
</style>
